# Data is downloaded by script, never committed, never redistributed.
# Anchored to the repo root: an unanchored data/ also swallowed the
# src/multicard/data package, so every clone was missing the corpus loaders
# and only the first CI run caught it.
/data/
!/data/README.md

# Caches (embeddings, LLM responses) are local checkpoints
/data/cache/
*.npz
*.sqlite

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Secrets and local env
.env
.env.*

# Paper build artifacts (main.pdf is built by CI/latexmk; .bbl IS committed for arXiv)
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# OS
.DS_Store

# Kill switch marker is never committed
FREEZE

# Local pointer to the private program-state repo (path only; never committed)
.boundary/

# uv lockfile is committed; the venv is not
.venv/

# Part 1: regenerable bulk outputs. The rendered contexts, the fused candidate
# lists with their per-channel provenance, and the full rankings are hundreds
# of megabytes per corpus and are rebuilt by part1_retrieve from the committed
# index artifacts. The scores, metrics, per-query rows, planner decisions,
# answers with both judges' verdicts and the failure buckets are committed.
/results/part1*/**/contexts_*.jsonl
/results/part1*/**/candidates.json
/results/part1*/**/rankings.json

# Version A source excerpts and local model call cache.
/results/version_a*/**/retrieval.jsonl
/results/version_a*/**/calls.sqlite*

# B/C/D source excerpts and source-derived fact/graph artifacts stay local.
/results/version_abcd*/**/contexts.jsonl
/results/version_abcd*/**/sample.json
/results/version_abcd*/**/groups/
/results/version_abcd*/_facts/
